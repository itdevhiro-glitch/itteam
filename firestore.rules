rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isRoot() { return signedIn() && request.auth.uid == 'Ogy9lUbGHbSu8wYIYx2gQsTtFDF2'; }
    function isIT() {
      return signedIn() && (
        isRoot() ||
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['Admin', 'Support', 'IT']
      );
    }

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update: if isIT();
      allow delete: if isRoot();
    }

    match /vendors/{vendorId} {
      allow read: if signedIn();
      allow create, update: if isIT();
      allow delete: if isRoot();
    }

    match /users/{uid}/assets_v2/{assetId} {
      allow read: if isOwner(uid) || isIT();
      allow create, update: if isIT();
      allow delete: if isRoot();
    }

    match /user_roles/{uid} {
      allow read: if isOwner(uid) || isRoot();
      allow write: if isRoot();
    }
  }
}
